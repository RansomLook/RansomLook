msgstr ""
"<strong>Réponse à incident</strong> → <a href=\"/recent\">/recent</a> "
"&nbsp;·&nbsp; <a href=\"/urls\">/urls</a> (vérifiez si une URL observée "
"correspond à un miroir suivi)."

#: website/web/templates/about.html:63
msgid ""
"<strong>CTI / trend analysis</strong> → <a href=\"/stats\">/stats</a> "
"&nbsp;·&nbsp; <a href=\"/hot\">/hot</a> (trending groups)."
msgstr ""
"<strong>CTI / analyse de tendance</strong> → <a "
"href=\"/stats\">/stats</a> &nbsp;·&nbsp; <a href=\"/hot\">/hot</a> "
"(groupes en tendance)."

#: website/web/templates/about.html:64
