[MAIN]
ignore-paths=.*__pycache__.*

[MESSAGES CONTROL]

disable=W1401,
        R0801,
        C0411,
        C0103,
        C0116,
        E0401,
        R0915,
        R0912,
        C0301,
        C0303,
        W0105,
        C0209,
        C0114,
        W0612,
        W0621,
        R1722,
        R1734,
        R1726,
        W0611,
        R1710,
        broad-exception-caught,
        use-maxsplit-arg,
        consider-using-with,
        missing-class-docstring,
        too-many-locals,
        too-many-nested-blocks,
        import-outside-toplevel,
        wrong-import-position,
        multiple-statements,
        no-else-return,
        singleton-comparison
